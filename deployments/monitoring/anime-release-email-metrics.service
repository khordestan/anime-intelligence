# Example only: no unit is installed or activated by this repository.
[Unit]
Description=Anime Intelligence release email scheduler metric snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=anime-monitor
Group=anime-monitor
EnvironmentFile=/etc/anime-intelligence/release-email-metrics.env
ExecStart=/opt/anime-intelligence/bin/release-email-status -format=prometheus -output-file=/var/lib/node_exporter/textfile_collector/anime_release_email.prom
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector
UMask=0027
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
