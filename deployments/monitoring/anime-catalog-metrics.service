# Example only: no unit is installed or activated by this repository.
[Unit]
Description=Anime Intelligence catalog freshness metric snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=anime-monitor
Group=anime-monitor
EnvironmentFile=/etc/anime-intelligence/catalog-metrics.env
ExecStart=/opt/anime-intelligence/bin/catalog-status -format=prometheus -output-file=/var/lib/node_exporter/textfile_collector/anime_catalog.prom
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector
UMask=0027
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
